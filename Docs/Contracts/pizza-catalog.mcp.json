            "title": "Declared Allergens",
            "type": "array"
          },
          "uncertain_ingredients": {
            "items": {
              "$ref": "#/$defs/UncertainIngredient"
            },
            "title": "Uncertain Ingredients",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "is_demo_data": {
            "title": "Is Demo Data",
            "type": "boolean"
          },
          "safety_note": {
            "title": "Safety Note",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "description",
          "price_czk",
          "available",
          "updated_at",
          "ingredients",
