          "UncertainIngredient": {
            "properties": {
              "ingredient": {
                "title": "Ingredient",
                "type": "string"
              },
              "note": {
                "title": "Note",
                "type": "string"
              }
            },
            "required": [
              "ingredient",
              "note"
            ],
            "title": "UncertainIngredient",
            "type": "object"
          }
        },
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "price_czk": {
            "title": "Price Czk",
            "type": "integer"
          },
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
