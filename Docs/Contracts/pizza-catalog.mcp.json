{
  "name": "pizza-catalog",
  "version": "0.1.0",
  "transport": "streamable-http",
  "path": "/mcp",
  "tools": [
    {
      "name": "list_pizzas",
      "description": "Vypsat pizzy; filtrovat přesnou kategorií, částí názvu a dostupností.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Category"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "available_only": {
            "default": true,
            "title": "Available Only",
            "type": "boolean"
          },
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "list_pizzasArguments"
      },
      "outputSchema": {
        "$defs": {
          "PizzaSummary": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "category": {
                "title": "Category",
                "type": "string"
              },
              "description": {
                "title": "Description",
                "type": "string"
              },
              "price_czk": {
                "title": "Price Czk",
                "type": "integer"
              },
              "available": {
                "title": "Available",
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "category",
              "description",
              "price_czk",
              "available"
            ],
            "title": "PizzaSummary",
            "type": "object"
          }
        },
        "properties": {
          "pizzas": {
            "items": {
              "$ref": "#/$defs/PizzaSummary"
            },
            "title": "Pizzas",
            "type": "array"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "is_demo_data": {
            "title": "Is Demo Data",
            "type": "boolean"
          }
        },
        "required": [
          "pizzas",
          "count",
          "limit",
          "source",
          "is_demo_data"
        ],
        "title": "PizzaList",
        "type": "object"
      }
    },
